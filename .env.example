# Supabase project (Settings → API). Local stack: written automatically to .env.local by `npm run stack:start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Creates logins (Users), sends emails and processes Toast webhooks.
SUPABASE_SERVICE_ROLE_KEY=
# Public address of the app, used for links in emails (e.g. https://inventory.pitaprincess.com).
APP_URL=
# Scheduled job secret (Vercel Cron sends it as a bearer token). Any long random string.
CRON_SECRET=
# Email through Resend (verify your domain in Resend first).
RESEND_API_KEY=
EMAIL_FROM="Pita Princess Inventory <reports@yourdomain.com>"
# Toast webhook signing secret from the Toast developer portal (live order sync).
TOAST_WEBHOOK_SECRET=
# Optional: AI invoice scanning on the receiving screen (extraction is always reviewed by a person).
ANTHROPIC_API_KEY=
