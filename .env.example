# Supabase project (Settings → API). Local stack: written automatically to .env.local by `npm run stack:start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used solely to create logins when a manager adds a person (Users & permissions).
SUPABASE_SERVICE_ROLE_KEY=
# Optional: enables AI invoice scanning on the receiving screen (extraction is always reviewed by a person).
ANTHROPIC_API_KEY=
